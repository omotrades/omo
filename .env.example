# Copy to .env and fill in what you have. Every variable is optional except where
# noted; omitted values degrade gracefully and the agent stays unarmed.

# --- execution -------------------------------------------------------------
# Signs swaps. Base58 (wallet export) or a JSON byte array.
# Verified on load to derive the published wallet address.
# LEAVE EMPTY unless you intend to trade real funds.
OMO_TRADING_KEY=

# Memo-only burner that publishes decision hashes. Never holds the book.
OMO_COMMIT_KEY=

# --- infrastructure --------------------------------------------------------
# Preferred Solana RPC. Public endpoints are used as fallback.
SOLANA_RPC_URL=

# Shared secret required by POST /api/public/cycle. Required to run cycles.
OMO_CYCLE_SECRET=

# Model access for the thesis stage.
OMO_MODEL_API_KEY=

# Optional overrides for the AI gateway and connector gateway base URLs.
# Defaults are used when empty.
OMO_AI_GATEWAY_URL=
OMO_CONNECTOR_GATEWAY_URL=

# --- database / client (managed) -------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
